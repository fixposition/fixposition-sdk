// https://aka.ms/devcontainer.json
{
    "dockerComposeFile": "../../docker/docker-compose.yaml",
    "shutdownAction": "stopCompose",

    "name": "Fixposition SDK (ROS1 Noetic)", "service": "noetic-dev", "runServices": [ "noetic-dev" ],

    // Use this user in the container, re-map IDs to local user automatically
    "remoteUser": "fpsdk",
    "updateRemoteUserUID": true,

    // compare .services.noetic-dev.volumes in ../../docker/docker-compose.yaml
    "workspaceFolder": "/home/fpsdk/fixposition-sdk",

    "initializeCommand": "${localWorkspaceFolder}/.devcontainer/helper.sh initializeCommand ${localWorkspaceFolder}",
    "onCreateCommand": "${containerWorkspaceFolder}/.devcontainer/helper.sh onCreateCommand ${containerWorkspaceFolder}",

    // Deliberately empty, see fpsdk.code-workspace instead
    "customizations": {}
}
